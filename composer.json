{
  "name": "divengine/runner",
  "license": "GPL-3.0-or-later",
  "description": "Lightweight PHP engine for Sequential Flow Model (SFM) flows: shared context, YAML flows compiled to PHP, calls, jumps and pause/resume.",
  "keywords": [
    "runner",
    "jobs",
    "workflow",
    "flow",
    "sfm",
    "sequential-flow-model",
    "yaml",
    "divengine"
  ],
  "homepage": "https://divengine.com",
  "authors": [
    {
      "name": "Rafa Rodriguez",
      "email": "rafageist@divengine.com",
      "homepage": "https://rafageist.com",
      "role": "Founder"
    }
  ],
  "support": {
    "issues": "https://github.com/divengine/runner/issues",
    "source": "https://github.com/divengine/runner",
    "docs": "https://github.com/divengine/runner/tree/main/docs"
  },
  "require": {
    "php": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "divengine\\runner\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "divengine\\runner\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpbench/phpbench": "^1.3",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "bench": "vendor/bin/phpbench run --report=aggregate --progress=none",
    "docs:pdf": "python scripts/build_pdf.py --output runner-documentation.pdf",
    "test": "vendor/bin/phpunit --colors=always",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
    "smoke": "bash scripts/smoke_install.sh"
  },
  "config": {
    "sort-packages": true
  }
}
